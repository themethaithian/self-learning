# Prod only (deploy/docker-compose.prod.yml): site hostname Caddy serves and
# gets a TLS cert for. Use "localhost" for a local prod-compose smoke test
# (plain HTTP, no cert); a real domain on the VPS.
DOMAIN=localhost

# Prod only: Let's Encrypt sends expiry/revocation notices here. Ignored on
# the internal-CA path (DOMAIN=localhost), required once DOMAIN is real.
ACME_EMAIL=you@example.com

# MySQL
# DB_HOST/DB_PORT below are for local `go run`/dev docker-compose.yml; the
# prod compose overrides DB_HOST=mysql, DB_PORT=3306 (the compose service
# name) regardless of what's set here.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=self_learning
DB_USER=app
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme_root

# LLM
ANTHROPIC_API_KEY=sk-ant-placeholder

# API auth
API_BEARER_TOKEN=changeme-bearer-token

# HTTP server (optional, defaults to 8080)
API_PORT=8080

# Local dev-only: host port for the root docker-compose.yml "web" (Caddy)
# service. Prod binds Caddy to 80/443 directly (see deploy/docker-compose.prod.yml).
WEB_PORT=3000

# CORS (optional, defaults to the Next.js dev origin). Prod serves the
# frontend same-origin through Caddy, so the browser never sends a CORS
# preflight there — this only matters if something calls the API
# cross-origin. Never set to "*": every request carries a bearer token.
CORS_ALLOWED_ORIGIN=http://localhost:3000
